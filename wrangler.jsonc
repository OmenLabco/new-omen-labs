{
  "name": "new-omen-labs",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "omenlabs.co", "custom_domain": true },
    { "pattern": "www.omenlabs.co", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // Non-secret runtime vars (mirrored from the Cloudflare dashboard so git
  // deploys keep them in sync). SQUARE_ACCESS_TOKEN stays a dashboard SECRET —
  // never put it here. Flip SQUARE_ENV to "production" (+ prod location id) to go live.
  "vars": {
    "SQUARE_ENV": "sandbox",
    "SQUARE_LOCATION_ID": "L8DE5MM05TRYZ"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omenlabs-orders",
      "database_id": "c7b4c843-6606-47f0-85f1-5e9d8eb29108"
    }
  ]
}
